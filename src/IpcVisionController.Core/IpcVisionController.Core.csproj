<Project Sdk="Microsoft.NET.Sdk">

  <!--
    平台中立的邏輯層 / Platform-neutral logic layer.
    刻意「不」相依 WinForms，因此 FSM、資料庫與配方層可在任何 OS 上執行單元測試。
    Deliberately has NO WinForms dependency, so the FSM, database and recipe
    layers can be unit-tested on any OS (including the dev Mac / Linux CI).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>IpcVisionController.Core</RootNamespace>
    <AssemblyName>IpcVisionController.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(MicrosoftDataSqliteVersion)" />
  </ItemGroup>

</Project>
